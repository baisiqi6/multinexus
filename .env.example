# MultiNexus — per-agent bot tokens
# Create one Discord Application per agent at https://discord.com/developers/applications
# Enable "Message Content Intent" in each bot's settings.
# Invite each bot with scopes: bot, applications.commands
# Permissions: Send Messages, Read Message History, Use Slash Commands

DISCORD_CLAUDE_TOKEN=
# DISCORD_CODEX_TOKEN=
# DISCORD_OPENCODE_TOKEN=
# DISCORD_OMP_TOKEN=
# DISCORD_HERMES_TOKEN=
# OPENAI_API_KEY=        # for Codex CLI (if used)
# PRIVATE_DB_PATH=        # optional absolute path for private SQLite DB
